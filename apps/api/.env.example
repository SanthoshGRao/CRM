# ─────────────────────────────────────────────────────────────
# CRM Platform — Environment Configuration Template
# Copy this to .env and fill in real values
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# Frontend URL (for CORS)
# Comma-separated to allow several origins (e.g. localhost and 127.0.0.1).
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

# ─── Database Options ─────────────────────────────────────────
# Option A: Local Native PostgreSQL (Windows Service)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_platform?schema=public"

# Option B: Single-file SQLite (Zero Installation)
# DATABASE_URL="file:./dev.db"

# ─── Redis (Optional / In-Memory Fallback) ────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── File Storage (Local Disk / S3) ───────────────────────────
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads

# S3 / MinIO (Optional if STORAGE_DRIVER=s3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=crm-files
S3_REGION=us-east-1

# ─── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Cookies ──────────────────────────────────────────────────
COOKIE_SECRET=your-cookie-signing-secret-change-in-production

# ─── API keys ─────────────────────────────────────────────────
# Encrypts stored API keys so they can be re-copied later. Falls back to
# JWT_ACCESS_SECRET if unset — set a dedicated value in production.
API_KEY_ENCRYPTION_SECRET=your-api-key-encryption-secret-change-in-production

# Refresh-cookie SameSite: lax | strict | none.
# "none" implies Secure (HTTPS) and is only needed when the web app is served
# from a different site than the API.
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.yourcrm.com

# Whether the refresh cookie gets the `Secure` attribute. Defaults to
# NODE_ENV === 'production' when unset. Browsers silently drop `Secure`
# cookies on a plain-HTTP origin, so if you run NODE_ENV=production without
# TLS in front of the API (e.g. serving over a bare IP), set this to "false"
# or every page reload will log users out.
# COOKIE_SECURE=false

# ─── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM="CRM Platform <noreply@yourcrm.com>"

# ─── Push notifications (Firebase Cloud Messaging) ────────────
# Firebase console → Project settings → Service accounts → Generate new
# private key. Paste the downloaded JSON here as one line. Push is silently
# disabled (not an error) while this is unset — see apps/mobile/README.md.
FIREBASE_SERVICE_ACCOUNT=

# ─── Billing (Razorpay) ────────────────────────────────────────
# Trial length for a new tenant, in days.
BILLING_TRIAL_DAYS=7
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set after creating a webhook in the Razorpay dashboard pointing at
# POST /api/v1/billing/webhook/razorpay
RAZORPAY_WEBHOOK_SECRET=
