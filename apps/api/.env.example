# ─────────────────────────────────────────────────────────────
# CRM Platform — Environment Configuration Template
# Copy this to .env and fill in real values
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# Frontend URL (for CORS)
# Comma-separated to allow several origins (e.g. localhost and 127.0.0.1).
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

# ─── Database Options ─────────────────────────────────────────
# Option A: Local Native PostgreSQL (Windows Service)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_platform?schema=public"

# Option B: Single-file SQLite (Zero Installation)
# DATABASE_URL="file:./dev.db"

# ─── Redis (Optional / In-Memory Fallback) ────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── File Storage (Local Disk / S3) ───────────────────────────
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads

# S3 / MinIO (Optional if STORAGE_DRIVER=s3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=crm-files
S3_REGION=us-east-1

# ─── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Cookies ──────────────────────────────────────────────────
COOKIE_SECRET=your-cookie-signing-secret-change-in-production

# Refresh-cookie SameSite: lax | strict | none.
# "none" implies Secure (HTTPS) and is only needed when the web app is served
# from a different site than the API.
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.yourcrm.com

# ─── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM="CRM Platform <noreply@yourcrm.com>"
